---
import { getIntegrationData } from "./integration-data-store.js";


const { prefix, disabled } = getIntegrationData();
const scriptPath = URL.parse("./target.js", `file://${prefix}/`)?.pathname;

if(!scriptPath) {
    console.warn("[Astro Chii Integration: WARN] Chii was requested but ");
}

---
{
    disabled || !scriptPath
        ? "" 
        : <script is:inline src={scriptPath}></script>
}